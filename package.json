  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "fallow": "^3.15.0",
    "typescript": "~6.0.2",
